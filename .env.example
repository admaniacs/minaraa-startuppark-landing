# Razorpay API keys — Dashboard → Account & Settings → API Keys.
# Use rzp_test_… keys while testing; switch to rzp_live_… keys to take real payments.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Optional: secret you set when adding the webhook in Dashboard → Webhooks
# (URL: https://<your-domain>/api/razorpay/webhook, events: payment.captured, order.paid).
# Records the registration even if the buyer closes the tab before the page confirms.
RAZORPAY_WEBHOOK_SECRET=

# Optional
PORT=3000
# Where confirmed registrations are appended (one JSON object per line).
DATA_DIR=./data

# ---- Pass email (any SMTP provider) ----
# Gmail / Google Workspace: smtp.gmail.com, port 465, your address + an App Password
#   (Google Account → Security → 2-Step Verification → App passwords). ~500 emails/day.
# Zoho: smtp.zoho.in 465 · Brevo: smtp-relay.brevo.com 587 · Amazon SES: email-smtp.ap-south-1.amazonaws.com 587
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM="MINARAA × Startup Park <hello@yourdomain.in>"
# Optional: where replies to the pass email go
MAIL_REPLY_TO=

# ---- Leads → Google Sheet ----
# Web app URL from integrations/google-sheets.gs (ends in /exec) and the SECRET set in that script.
SHEETS_WEBHOOK_URL=
SHEETS_SECRET=
